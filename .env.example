# ==============================================================================
# Bengaluru Traffic Detective — Environment Configuration
# ==============================================================================

# DATA_MODE: 'demo' (deterministic synthetic records) or 'bigquery' (live GCP queries)
DATA_MODE="bigquery"

# GOOGLE_CLOUD_PROJECT: Your Google Cloud Project ID (e.g., datadetective-514513)
GOOGLE_CLOUD_PROJECT="datadetective-514513"

# BIGQUERY_DATASET: Canonical dataset name
BIGQUERY_DATASET="bengaluru_mobility"

# BIGQUERY_TABLE: Canonical partitioned table name
BIGQUERY_TABLE="incidents"

# BIGQUERY_LOCATION: BigQuery dataset region ('US' or region chosen at dataset creation)
BIGQUERY_LOCATION="US"

# GEMINI_API_KEY: Required for Gemini AI interpretations (injected by AI Studio Secrets)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Free-tier eligible Flash model ID (e.g., gemini-2.5-flash or gemini-3.8-flash)
GEMINI_MODEL="gemini-3.8-flash"

# BIGQUERY_SERVICE_ACCOUNT_JSON: Optional for hosted AI Studio preview if permitted by policy
# Paste full service account JSON into Secrets (never in code or client bundle)
# BIGQUERY_SERVICE_ACCOUNT_JSON="{...}"

# APP_URL: The URL where this applet is hosted
APP_URL="MY_APP_URL"
